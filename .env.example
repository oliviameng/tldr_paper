
# Read only by the Node server. Never expose this value through a VITE_* variable.
# Get your API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional. Vite uses port 3000 and proxies /api requests to this server.
PORT=3001
# The API binds to loopback by default. Expose it only behind an authenticated gateway.
# HOST=0.0.0.0
